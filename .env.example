# =============================================================================
# Infrastructure environment variables
# Copy this file to .env and adjust values if needed.
# =============================================================================

# --- Docker Compose ---
# Project name prefixes container/volume/network names.
# Change it to run multiple checkouts in parallel.
COMPOSE_PROJECT_NAME=pizza-shop-api

# --- Host ports ---
# These are the ports on YOUR machine that map to container ports.
# Change them if they conflict with something already running locally.
NGINX_PORT=8080
POSTGRES_PORT=5432

# --- Host user ---
# UID/GID of your local user. On Linux this makes bind-mounted files
# editable without sudo. On macOS/Windows leave 1000 / 1000.
UID=1000
GID=1000

# --- PostgreSQL ---
POSTGRES_DB=pizza_shop
POSTGRES_USER=pizza
POSTGRES_PASSWORD=pizza_secret
